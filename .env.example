APP_NAME=agentic-rag-platform
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
QDRANT_URL=http://qdrant:6333
OTEL_EXPORTER_OTLP_ENDPOINT=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
QUEUE_BACKEND=kafka
KAFKA_INGEST_TOPIC=documents.ingest
KAFKA_RETRY_TOPIC=documents.ingest.retry
KAFKA_DLQ_TOPIC=documents.ingest.dlq
KAFKA_CONSUMER_GROUP=ingestion-workers
KAFKA_CONSUMER_CONCURRENCY=2
WORKSPACE_COOKIE_SECRET=dev-local-change-me
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_SIZE=384
EMBEDDING_BATCH_SIZE=32
CHUNK_SIZE=900
CHUNK_OVERLAP=140
MAX_DOCUMENT_CHARS=5000000
MAX_UPLOAD_BYTES=20000000
MAX_CHUNKS_PER_DOCUMENT=10000
RETRIEVAL_CANDIDATE_K=48
SPARSE_CANDIDATE_LIMIT=200
RETRIEVAL_MODE=hybrid
RERANKER_MODEL=
MAX_CHUNKS_PER_DOCUMENT_IN_RESPONSE=2
MAX_RETRIES=3
RETRY_BASE_SECONDS=5
RETRY_MAX_SECONDS=300
RETRY_POLL_SECONDS=1
RECONCILIATION_POLL_SECONDS=60
JOB_TTL_SECONDS=604800
SESSION_TTL_SECONDS=86400
LOCAL_INGESTION_ROOT=/data
ALLOWED_WEB_DOMAINS=
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
